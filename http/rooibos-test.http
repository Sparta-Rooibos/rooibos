### rooibos-test.http

### 환경 설정
@baseUrl = http://localhost:19091
@token = your_jwt_token_here

### 1. Client 회원가입
# @name signup
POST {{baseUrl}}/api/v1/user/signup
Content-Type: application/json

{
  "username": "clientuser",
  "email": "client@example.com",
  "password": "Test123!@#",
  "slackAccount": "clientuser",
  "phone": "010-1234-5678",
  "role": "CLIENT"
}

### 2. Client Manager 생성
# @name createClientManager
POST {{baseUrl}}/api/v1/client/manager
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "테스트 업체",
  "clientType": "CLIENT",
  "managedHubId": "허브UUID",
  "address": "서울시 강남구"
}

### 3. 상품 생성
# @name createProduct
POST {{baseUrl}}/api/v1/product
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "테스트 상품",
    "clientId": "{{createClientManager.response.body.id}}"
}

### 4. 재고 생성
# @name createStock
POST {{baseUrl}}/api/v1/stock
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "hubId": "허브UUID",
    "productId": "{{createProduct.response.body.id}}",
    "productQuantity": 100
}

### 5. 주문 생성
# @name createOrder
POST {{baseUrl}}/api/v1/orders
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "requestClientId": "{{createClientManager.response.body.id}}",
    "receiveClientId": "{{createClientManager.response.body.id}}",
    "productId": "{{createProduct.response.body.id}}",
    "quantity": 1,
    "requirement": "테스트 주문 요구사항"
}

### 6. 주문 상태 업데이트
# @name updateOrderStatus
PUT {{baseUrl}}/api/v1/orders
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "id": "{{createOrder.response.body.orderId}}",
    "status": "SHIPPED"
}

### 7. 배송 로그 생성
# @name createDeliveryLog
POST {{baseUrl}}/api/v1/deliveryLog
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "deliveryId": "{{createOrder.response.body.deliveryId}}",
    "departure": "출발지UUID",
    "departureName": "출발지명",
    "arrival": "도착지UUID",
    "arrivalName": "도착지명",
    "sequence": 1,
    "expectedDistance": "100",
    "expectedTime": "30"
}

### 8. 배송 로그 조회
# @name getDeliveryLog
GET {{baseUrl}}/api/v1/deliveryLog/{{createDeliveryLog.response.body.id}}
Authorization: Bearer {{token}}

### 9. 배송 로그 상태 업데이트
# @name updateDeliveryLogStatus
PUT {{baseUrl}}/api/v1/deliveryLog
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "deliveryLogId": "{{createDeliveryLog.response.body.id}}",
    "status": "COMPLETED"
}

### 10. 주문 조회
# @name getOrder
GET {{baseUrl}}/api/v1/orders/{{createOrder.response.body.orderId}}
Authorization: Bearer {{token}}